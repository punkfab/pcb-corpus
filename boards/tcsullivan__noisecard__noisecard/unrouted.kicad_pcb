	(gr_text "FILES:\n\nDRL=DRILL TOOL SIZE INFORMATION (MM)\nGM1=OUTLINE\nGTL=TOP LAYER\nGBL=BOT LAYER\nGTO=SILKSCREEN TOP\nGBO=SILKSCREEN BOT\nGTS=SOLDER MASK TOP\nGBS=SOLDER MASK BOT\nGTP=TOP STENCIL\nGBP=BOTTOM STENCIL\nPOS=TOP PLACE FILE\nBOM=BILL OF MATERIALS\nSCHEMATIC\nFABDRAWING"
