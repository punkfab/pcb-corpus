	(gr_text "this board is about giving you control.\nunderstanding what makes a laptop tick\nbrings you one step closer to power.\n\ncorps don't want such boards to be built.\nthe previous board was doomed to expire,\n burdened with a number of proprietary  mechanisms;\n   for instance, a mechanism that prohibited aftermarket batteries.\n"
		(at 194.93 121.72 0)
		(layer "B.SilkS")
		(uuid "95e99790-c5e5-4743-b8b2-17c7c5c5e26e")
		(effects
			(font
				(size 1.2 1.2)
				(thickness 0.2)
				(bold yes)
			)
			(justify left bottom mirror)
		)
	)
