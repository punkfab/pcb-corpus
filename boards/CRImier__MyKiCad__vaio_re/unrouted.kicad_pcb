	(gr_text "keyboard\n+ trackpoint\n+ buttons\n+ LEDs"
		(at 124.37 112.95 0)
		(layer "F.SilkS")
		(uuid "ffbfb6ee-8177-49d4-9fa7-e3f05f782bea")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
			(justify bottom)
		)
	)
	(gr_text "  Features:\n-LCD backlight driver\n-DPI-LVDS conv 4 LCD(e,A)\n-Keyboard,trackpoint cntrl (e,A)\n-LCD, batt, left, keeb conns (e,A,W)\n-always-on EC with in-hw recovery mode\n-5-15V VIN (FET bypass for 5V in)\n-LiIon 1s battery charger (switching)\n-ESD diodes on *all* external IO (bar LED)\n-external USB current limit&control\n-expansion (2*usb2/8*io/vchg/vin/i2c/3v3)\n-Pi Zero HDMI access & 5V boost add&Ilim\n-2*qwiic (zero&2040), i2c eeprom, rtc\n-in-system kbc(kb controller) flash\n-ec & kbc(optional) i2c-hid\n -i2c/gpio/ts on batt conn"
		(at 146.35 98.65 0)
		(layer "F.SilkS")
		(uuid "c6235dbd-a514-4360-b93d-e9561f8aac59")
		(effects
			(font
				(size 0.85 0.85)
				(thickness 0.12)
			)
			(justify left bottom)
		)
	)
