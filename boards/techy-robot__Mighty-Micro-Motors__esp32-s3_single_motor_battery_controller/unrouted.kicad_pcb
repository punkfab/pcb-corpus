		(border yes)
		(stroke
			(width 0.1)
			(type solid)
		)
	)
	(gr_text_box "Highspeed signals in the PSU: All lines going to mosfets and inductor, i2c lines"
		(start 119.05 120.4)
		(end 129.75 125.7)
		(margins 0.425 0.425 0.425 0.425)
