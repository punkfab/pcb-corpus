	(gr_text "Little Big Scroll 6 - v1.1.1\nMarkus Knutsson 2022\nhttps://github.com/TweetyDaBird"
		(at 108.361388 91.69 0)
		(layer "F.SilkS")
		(uuid "d5bf55c3-ecaf-45d4-8497-7194dc0b10f3")
		(effects
